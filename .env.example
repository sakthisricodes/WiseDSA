# ==============================================================================
# DSA Tracker — Production Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Connection (Supabase PostgreSQL / Neon / Self-hosted Postgres)
# ------------------------------------------------------------------------------
# For Vercel Serverless deployments with Supabase:
# Use Supabase's Transaction Connection Pooler URL (port 6543) with ?pgbouncer=true
# Example: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dsa_tracker?schema=public"

# Optional: Direct connection for running migrations/seeds outside serverless if needed
# DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# 2. Clerk Authentication (Production & Development)
# ------------------------------------------------------------------------------
# Retrieve from https://dashboard.clerk.com -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_placeholder"
CLERK_SECRET_KEY="sk_test_placeholder"

# Clerk Route Handlers
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# ------------------------------------------------------------------------------
# 3. Application Metadata
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="WiseDSA"
